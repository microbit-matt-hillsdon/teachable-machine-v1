.output__code {
	position: absolute
	width: 100%
	height: 100%
	background: $color__white
}

.button--open-makecode {
	font-family: $font;
	font-size: 14px;
	background: $color__white;
	color: $color__text--light;
	border: 4px solid $color__background;
	cursor: pointer;
	width: 80%;
	padding: 5px 0;
}

.output__code-editor {
	position: fixed;
	flex-direction: column;
	right: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: 102;
}

.output__code-editor .top-bar {
	width: 100%;
	height: 3rem;
	background: $color__background;
	text-align: start;
}

.output__code-editor .top-bar button {
	font-family: $font;
	font-size: 16px;
	height: 100%;
	border: none;
	padding: 0 2em;
	cursor: pointer;
}

.output__code-editor .iframe-wrapper {
	display: flex;
	flex-grow: 1;
  	flex-direction: column;
	width: 100%
}

.output__code-editor iframe {
	border: none;
}

dialog {
	font-family: $font;
	font-size: 16px;
}

dialog::backdrop {
  background-color: $color__black;
  opacity: 0.5;
}