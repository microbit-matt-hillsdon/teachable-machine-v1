.fps-control {
	position: fixed
	top: 8px
	left: 8px
	z-index: 9999
	display: flex
	align-items: center
	gap: 8px
	padding: 4px 10px
	background: rgba(255, 255, 255, 0.7)
	border-radius: 14px
	font-family: 'Poppins', sans-serif
	font-size: 11px
	line-height: 1
	color: #333
	box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08)
	opacity: 0.45
	transition: opacity 0.15s ease
}

.fps-control:hover {
	opacity: 1
}

.fps-control__label {
	font-weight: 600
	letter-spacing: 0.5px
	text-transform: uppercase
}

.fps-control__slider {
	width: 140px
	cursor: pointer
}

.fps-control__value {
	min-width: 32px
	text-align: right
	font-variant-numeric: tabular-nums
}
